diff --git a/drivers/media/usb/uvc/uvc_video.c b/drivers/media/usb/uvc/uvc_video.c
index f6c8e3223..84d77e54e 100644
--- a/drivers/media/usb/uvc/uvc_video.c
+++ b/drivers/media/usb/uvc/uvc_video.c
@@ -2007,6 +2007,24 @@ static int uvc_video_start_transfer(struct uvc_streaming *stream,
 		/* Isochronous endpoint, select the alternate setting. */
 		bandwidth = stream->ctrl.dwMaxPayloadTransferSize;
 
+		/*
+		 * Many MJPEG cameras report a worst-case payload size far above
+		 * what they actually send (e.g. 3072 B/uframe for ~200 B/uframe
+		 * of real data), which exhausts the high-speed periodic budget
+		 * with two cameras on one bus. Optionally cap the reservation
+		 * for compressed formats; the device paces its data to the
+		 * packet size of the alternate setting it is given.
+		 */
+		if (uvc_mjpeg_max_payload_param &&
+		    stream->cur_format &&
+		    (stream->cur_format->flags & UVC_FMT_FLAG_COMPRESSED) &&
+		    bandwidth > uvc_mjpeg_max_payload_param) {
+			dev_info(&stream->intf->dev,
+				 "Capping compressed payload %u -> %u B/frame (mjpeg_max_payload)\n",
+				 bandwidth, uvc_mjpeg_max_payload_param);
+			bandwidth = uvc_mjpeg_max_payload_param;
+		}
+
 		if (bandwidth == 0) {
 			uvc_dbg(stream->dev, VIDEO,
 				"Device requested null bandwidth, defaulting to lowest\n");
